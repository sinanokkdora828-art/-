import requests
import pandas as pd
from datetime import datetime

# ==========================================
# ① 各県庁所在地の情報
# ==========================================

cities = {
    "茨城県": {
        "city": "水戸",
        "pref_code": "080000",
        "city_code": "40201"
    },
    "栃木県": {
        "city": "宇都宮",
        "pref_code": "090000",
        "city_code": "41277"
    },
    "群馬県": {
        "city": "前橋",
        "pref_code": "100000",
        "city_code": "42251"
    },
    "埼玉県": {
        "city": "さいたま",
        "pref_code": "110000",
        "city_code": "43056"
    },
    "東京都": {
        "city": "東京",
        "pref_code": "130000",
        "city_code": "44132"
    },
    "千葉県": {
        "city": "千葉",
        "pref_code": "120000",
        "city_code": "45212"
    },
    "神奈川県": {
        "city": "横浜",
        "pref_code": "140000",
        "city_code": "46106"
    }
}


# ==========================================
# ② 今日の日付
# ==========================================

today = datetime.now().strftime("%Y-%m-%d")


# ==========================================
# ③ 気象庁APIからデータを取得
# ==========================================

results = []

for prefecture, codes in cities.items():

    # 気象庁API
    url = f"https://www.jma.go.jp/bosai/forecast/data/forecast/{codes['pref_code']}.json"

    # APIにアクセス
    response = requests.get(url)

    # エラーがあれば停止
    response.raise_for_status()

    # JSONを取得
    data = response.json()


    # ======================================
    # ④ 県庁所在地のデータを探す
    # ======================================

    found = False

    for timeseries in data[0]["timeSeries"]:

        for area in timeseries["areas"]:

            # 県庁所在地の地点コードが一致
            if area["area"]["code"] == codes["city_code"]:

                # tempsが存在するか確認
                if "temps" in area:

                    temps = [
                        float(x)
                        for x in area["temps"]
                        if x != ""
                    ]

                    # 気温データが存在する場合
                    if len(temps) > 0:

                        # ==================================
                        # ⑤ データを保存
                        # ==================================

                        results.append({
                            "日付": today,
                            "都道府県": prefecture,
                            "地点": codes["city"],
                            "最低気温": min(temps),
                            "最高気温": max(temps),
                            "平均気温": sum(temps) / len(temps)
                        })

                        found = True

                break

        if found:
            break


# ==========================================
# ⑥ DataFrameに変換
# ==========================================

df_weather = pd.DataFrame(results)


# ==========================================
# ⑦ 列の順番を整理
# ==========================================

df_weather = df_weather[
    [
        "日付",
        "都道府県",
        "地点",
        "最低気温",
        "最高気温",
        "平均気温"
    ]
]


# ==========================================
# ⑧ 表示
# ==========================================

print(df_weather)
